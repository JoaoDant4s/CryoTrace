<mxfile host="app.diagrams.net">
  <diagram id="cryotrace-architecture" name="Architecture">
    <mxGraphModel dx="900" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="700" pageHeight="880" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Cloud boundary -->
        <mxCell id="cloud" value="Cloud" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="30" y="250" width="590" height="470" as="geometry" />
        </mxCell>

        <!-- Thermal box (edge) -->
        <mxCell id="sensor" value="Temperature Sensor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="20" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="esp32" value="ESP32-S3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="140" width="170" height="60" as="geometry" />
        </mxCell>

        <!-- Cloud components -->
        <mxCell id="broker" value="MQTT Broker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="290" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="relayer" value="Relayer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="420" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="influx" value="InfluxDB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;dashed=1;fontColor=#666666;opacity=70;" vertex="1" parent="1">
          <mxGeometry x="60" y="550" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="grafana" value="Grafana" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;dashed=1;fontColor=#666666;opacity=70;" vertex="1" parent="1">
          <mxGeometry x="60" y="640" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="chain" value="Blockchain" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="400" y="540" width="190" height="140" as="geometry" />
        </mxCell>
        <mxCell id="contract" value="Smart Contract" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="415" y="585" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- Audit -->
        <mxCell id="app" value="Audit App" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="770" width="190" height="60" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="Dashed: designed, not implemented" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#666666;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="785" width="220" height="30" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e_sensor_esp" value="reading every 500 ms" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sensor" target="esp32">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="70" y="0" as="offset" />
          </mxGeometry>
        </mxCell>

        <mxCell id="e_esp_broker" value="signed events,&lt;br&gt;status (MQTT/TLS)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;align=right;" edge="1" parent="1" source="esp32" target="broker">
          <mxGeometry relative="1" x="-0.35" as="geometry">
            <mxPoint x="-12" y="0" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e_broker_esp" value="batch&lt;br&gt;announcement" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;align=left;" edge="1" parent="1" source="broker" target="esp32">
          <mxGeometry relative="1" x="0.35" as="geometry">
            <mxPoint x="12" y="0" as="offset" />
          </mxGeometry>
        </mxCell>

        <mxCell id="e_broker_relayer" value="signed events" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;align=right;" edge="1" parent="1" source="broker" target="relayer">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-12" y="0" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e_relayer_broker" value="batch&lt;br&gt;announcement" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;align=left;" edge="1" parent="1" source="relayer" target="broker">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="12" y="0" as="offset" />
          </mxGeometry>
        </mxCell>

        <mxCell id="e_relayer_contract" value="recordEvent&lt;br&gt;(transaction)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0.6;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="relayer" target="chain">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_contract_relayer" value="new batches&lt;br&gt;(event logs)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="contract" target="relayer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_app_chain" value="registrations,&lt;br&gt;queries" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.3;exitY=0;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;align=right;" edge="1" parent="1" source="app" target="chain">
          <mxGeometry relative="1" x="-0.35" as="geometry">
            <mxPoint x="-12" y="0" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e_chain_app" value="batch history" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;align=left;" edge="1" parent="1" source="chain" target="app">
          <mxGeometry relative="1" x="0.35" as="geometry">
            <mxPoint x="12" y="0" as="offset" />
          </mxGeometry>
        </mxCell>

        <mxCell id="e_broker_influx" value="telemetry" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#999999;fontColor=#666666;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="broker" target="influx">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_influx_grafana" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#999999;" edge="1" parent="1" source="influx" target="grafana">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
