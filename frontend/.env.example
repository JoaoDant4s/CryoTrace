# Copy to .env (optional: the defaults below already point to the Sepolia deployment).
#
# Read-only RPC. Everything in VITE_* ends up in the JavaScript bundle, so do NOT
# put an Infura URL with your API key here if you publish the site. The default
# is a free public Sepolia node. Transactions always go through the browser
# wallet (MetaMask), never through this URL.
# VITE_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Sepolia (11155111, default) or anvil (31337) for local testing.
# VITE_CHAIN_ID=11155111
# VITE_CONTRACT_ADDRESS=0xF8A328b314C89Ef22E3494886A00419Dcc434Dd4
# First block to scan for contract logs (the deploy block).
# VITE_DEPLOY_BLOCK=12190943

# How often the audit and activity views refresh, in ms.
# VITE_POLL_MS=30000
