# Copy to .env (git-ignored) and load with:  set -a; . ./.env; set +a

# Sepolia RPC, e.g. from Alchemy or Infura (free tier)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<your-key>
# Optional: verify the contract source on Etherscan (--verify)
ETHERSCAN_API_KEY=

# Filled in after the deploy, used by Provision.s.sol
CONTRACT_ADDRESS=
BOX_ID=box01
BATCH_ID=batch-demo-001
DEVICE_ADDRESS=
