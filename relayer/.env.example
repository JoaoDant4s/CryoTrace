# Copy to .env and fill in. Load with:  set -a; . ./.env; set +a
# .env is git-ignored: it holds the relayer's private key and broker password.

# Blockchain
SEPOLIA_RPC_URL=https://sepolia.example-rpc.io
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
# Key of the account that pays the gas (needs testnet ETH). Never commit it.
RELAYER_PRIVATE_KEY=0x...
# Optional: ABI file (default: ../contracts/out/CryoTrace.sol/CryoTrace.json)
# CONTRACT_ABI=

# MQTT (HiveMQ Cloud)
MQTT_HOST=xxxxxxxx.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_TLS=1
MQTT_USERNAME=
MQTT_PASSWORD=
# Optional
# MQTT_TOPIC=cryotrace/+/anomaly
# Must be unique per relayer instance (the broker drops a client when another
# connects with the same id).
# MQTT_CLIENT_ID=cryotrace-relayer
# Backup relayers: wait this long before submitting, and only pay gas if the
# event is still not on-chain by then (0 = primary, submits immediately).
# SUBMIT_DELAY_S=0

# Batch announcements: publish, retained, the batch the contract assigned to each
# box on cryotrace/<boxId>/batch (the box signs its events with it).
# BATCH_ANNOUNCE=1
# How often to look for new BatchRegistered events (each scan costs RPC credits).
# BATCH_POLL_S=60
# First block to scan: the contract's deploy block (Sepolia: 12190943).
START_BLOCK=12190943
# Max blocks per eth_getLogs call (lower it if the RPC limits the range).
# LOG_CHUNK_BLOCKS=50000
