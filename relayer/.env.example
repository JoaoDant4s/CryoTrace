# Copy to .env and fill in. Load with:  set -a; . ./.env; set +a
# .env is git-ignored: it holds the relayer's private key and broker password.

# Blockchain
RPC_URL=https://sepolia.example-rpc.io
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
# Key of the account that pays the gas (needs testnet ETH). Never commit it.
RELAYER_PRIVATE_KEY=0x...
# Optional: ABI file (default: ../contracts/out/CryoTrace.sol/CryoTrace.json)
# CONTRACT_ABI=

# MQTT (HiveMQ Cloud)
MQTT_HOST=xxxxxxxx.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_TLS=1
MQTT_USERNAME=
MQTT_PASSWORD=
# Optional
# MQTT_TOPIC=coldchain/+/anomaly
# MQTT_CLIENT_ID=cryotrace-relayer
